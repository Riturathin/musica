AUTH_SECRET=
AUTH_URL=http://localhost:3010

OIDC_NAME=OIDC
OIDC_ISSUER=https://your-issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email

# Optional: set this when the discovery document is not at {OIDC_ISSUER}/.well-known/openid-configuration.
# OIDC_WELL_KNOWN=

# Optional: enables the local demo sign-in provider outside development.
# DEV_AUTH_ENABLED=false
